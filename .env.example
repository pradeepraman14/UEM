# ============================================================
# UEM Platform - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ----- Database -----
POSTGRES_DB=uem
POSTGRES_USER=uem
POSTGRES_PASSWORD=change_me_db_password

# ----- Redis -----
REDIS_PASSWORD=change_me_redis_password

# ----- JWT / Auth -----
JWT_SECRET_KEY=change_me_very_long_random_secret_key_32_chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- Initial Admin Account -----
INITIAL_ADMIN_EMAIL=admin@uem.local
INITIAL_ADMIN_PASSWORD=Admin@123456

# ----- Server -----
SERVER_BASE_URL=https://your-server-ip-or-domain
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ----- PKI / Certificates -----
CA_CERT_PATH=/app/pki/ca/ca.crt
CA_KEY_PATH=/app/pki/ca/ca.key
CERT_VALIDITY_DAYS=365

# ----- Agent -----
AGENT_HEARTBEAT_INTERVAL=30
AGENT_INVENTORY_INTERVAL=3600
AGENT_PATCH_CHECK_INTERVAL=86400

# ----- Email Notifications (SMTP) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@uem.local
SMTP_TLS=true

# ----- Paths -----
PACKAGES_DIR=/app/packages
LOGS_DIR=/app/logs

# ----- Celery -----
CELERY_RESULT_BACKEND=redis://:change_me_redis_password@redis:6379/1
